{
  "uid": "rooms-alerts",
  "title": "Rooms & alerts",
  "tags": ["vkr", "iot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Текущее состояние помещений",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT room_id, temperature, humidity, co2, smoke, motion, light, updated_at FROM room_states ORDER BY room_id",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Показания датчиков за выбранный период",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "showPoints": "auto",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT recorded_at AS time, sensor_type AS metric, value FROM sensor_events WHERE $__timeFilter(recorded_at) ORDER BY recorded_at",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Активные алерты",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT triggered_at, room_id, sensor_type, rule_name, severity, message, triggering_value FROM alerts WHERE resolved_at IS NULL ORDER BY triggered_at DESC LIMIT 100",
          "refId": "A"
        }
      ]
    }
  ]
}
